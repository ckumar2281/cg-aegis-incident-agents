# ---------------------------------------------------------------------------
# Aegis configuration. Copy to .env and fill in.
#
#   cp .env.example .env
#
# Everything has a working default: with no .env at all, Aegis runs fully
# offline on the simulated platform with the deterministic reasoner, at $0.
# Turn on real services one at a time.
# ---------------------------------------------------------------------------

# --- Backends --------------------------------------------------------------
# heuristic = deterministic, free, used for dev/tests/evals
# bedrock   = real Claude models via AWS
AEGIS_MODEL_BACKEND=heuristic

# simulated = built-in Northwind warehouse (no credentials needed)
# snowflake = your real account
AEGIS_PLATFORM=simulated

# --- AWS Bedrock -----------------------------------------------------------
AWS_REGION=us-east-2
# Either a Bedrock API key (simplest -- Bedrock console > Discover > API keys):
# AWS_BEARER_TOKEN_BEDROCK=
# ...or ordinary AWS credentials via `aws configure` / AWS_PROFILE.

# Run scripts/check_bedrock.py to discover the exact IDs your account can invoke.
AEGIS_CHEAP_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
AEGIS_STRONG_MODEL=us.anthropic.claude-sonnet-5-20260514-v1:0

# --- Cost governor ---------------------------------------------------------
# Hard ceilings per incident. On breach the remaining agents degrade to the
# heuristic backend and the incident is stamped `degraded_reasoning`.
AEGIS_MAX_USD_PER_INCIDENT=0.50
AEGIS_MAX_LLM_CALLS=24
AEGIS_MAX_ROUNDS=2
AEGIS_DEGRADE_ON_BREACH=true

# --- Snowflake -------------------------------------------------------------
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_ROLE=AEGIS_AGENT
# SNOWFLAKE_WAREHOUSE=AEGIS_WH_XS
# SNOWFLAKE_DATABASE=AEGIS
# SNOWFLAKE_SCHEMA=OPS

# --- Storage ---------------------------------------------------------------
AEGIS_RAW_BUCKET=aegis-raw
AEGIS_QUARANTINE_BUCKET=aegis-quarantine

# --- Integrations ----------------------------------------------------------
# mock | jira | servicenow
AEGIS_TICKET_PROVIDER=mock
# mock | github
AEGIS_VCS_PROVIDER=mock
# mock | ses
AEGIS_EMAIL_PROVIDER=mock

# AEGIS_GITHUB_REPO=your-org/northwind-dbt
# GITHUB_TOKEN=
# JIRA_BASE_URL=
# JIRA_PROJECT_KEY=
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# --- Approval chain --------------------------------------------------------
# Gmail plus-addressing works well for a demo: all four land in one inbox
# but act as four distinct approvers.
AEGIS_PO_EMAIL=product.owner@example.com
AEGIS_SM_EMAIL=scrum.master@example.com
AEGIS_DEV_EMAIL=dev.team@example.com
AEGIS_EM_EMAIL=eng.manager@example.com
AEGIS_PIPELINE_OWNER_EMAIL=pipeline.owner@example.com

AEGIS_TOKEN_TTL_MIN=1440
AEGIS_TIMEOUT_BEHAVIOUR=escalate
AEGIS_APPROVAL_BASE_URL=https://approvals.example.com

# Used to sign approval tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AEGIS_SIGNING_SECRET=dev-only-not-a-real-secret

# --- RCA gating ------------------------------------------------------------
AEGIS_RCA_CONFIDENCE=0.72
AEGIS_RCA_ESCALATE_BELOW=0.40
